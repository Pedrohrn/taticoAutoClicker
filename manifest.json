{
  "manifest_version": 3,
  "name": "Tatico AutoClicker",
  "version": "1.0",
  "description": "AutoClicker injetável para TVs Tatico",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": "logo.png"
  },
  "content_scripts": [
    {
      "matches": ["*://app.powerbi.com/view?r=*"],
      "js": ["autoClicker.js"],
      "run_at": "document_end"
    }
  ]
}