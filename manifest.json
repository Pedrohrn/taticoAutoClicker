{
  "manifest_version": 3,
  "name": "Tatico AutoClicker & Revolver",
  "version": "3.0",
  "description": "AutoClicker modular e Auto Tab Revolver para TVs Tatico",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "js/background/background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_icon": "logo.png",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "css": [
        "css/components.css"
      ],
      "js": [
        "js/content/autoClicker.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "config.json"
      ],
      "matches": [
        "*://app.powerbi.com/*"
      ]
    }
  ]
}
